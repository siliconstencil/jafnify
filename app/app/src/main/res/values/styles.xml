<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The one filled action per screen. -->
    <style name="JafnifyPrimaryButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/jafnify_primary_on</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/jafnify_type_body_large</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">@dimen/jafnify_spacing_xl</item>
        <item name="android:paddingEnd">@dimen/jafnify_spacing_xl</item>
    </style>

    <!-- Quiet text action, flush with the body text instead of a button indent. -->
    <style name="JafnifyTextButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:textColor">@color/jafnify_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/jafnify_type_body</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">@dimen/jafnify_spacing_xl</item>
    </style>
</resources>
