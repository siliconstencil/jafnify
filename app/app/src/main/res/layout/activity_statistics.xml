<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/jafnify_spacing_md">

    <include
        layout="@layout/header_screen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/jafnify_spacing_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jafnify_spacing_sm"
                android:text="@string/statistics_hint"
                android:textColor="@color/jafnify_muted"
                android:textSize="@dimen/jafnify_type_body" />

            <RadioGroup
                android:id="@+id/statWindows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jafnify_spacing_md"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/statToday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="@string/statistics_today"
                    android:textSize="@dimen/jafnify_type_body" />

                <RadioButton
                    android:id="@+id/statWeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="@string/statistics_week"
                    android:textSize="@dimen/jafnify_type_body" />

                <RadioButton
                    android:id="@+id/statMonth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="@string/statistics_month"
                    android:textSize="@dimen/jafnify_type_body" />
            </RadioGroup>

            <TextView
                android:id="@+id/statLines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jafnify_spacing_lg"
                android:lineSpacingExtra="@dimen/jafnify_spacing_xs"
                android:textSize="@dimen/jafnify_type_body"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/statNetwork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jafnify_spacing_lg"
                android:lineSpacingExtra="@dimen/jafnify_spacing_xs"
                android:textSize="@dimen/jafnify_type_body"
                android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
