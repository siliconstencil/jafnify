<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/jafnify_spacing_md">

    <include
        layout="@layout/header_screen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/jafnify_spacing_xl">

            <TextView
                android:id="@+id/tLayoutHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jafnify_spacing_sm"
                android:text="@string/home_layout_hint"
                android:textColor="@color/jafnify_muted"
                android:textSize="@dimen/jafnify_type_body" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
