<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/jafnify_spacing_sm">

    <include
        layout="@layout/header_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/jafnify_spacing_sm">

            <!-- Welcome: the mark carries the state, the sentence explains it. -->
            <LinearLayout
                android:id="@+id/heroBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jafnify_spacing_xl"
                android:layout_marginBottom="@dimen/jafnify_spacing_lg"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/heroJ"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_brand_j_64" />

                    <ImageView
                        android:id="@+id/heroArcs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_brand_arcs_64" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jafnify_spacing_md"
                    android:gravity="center_horizontal"
                    android:textSize="@dimen/jafnify_type_body_large" />

                <TextView
                    android:id="@+id/tHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jafnify_spacing_sm"
                    android:gravity="center_horizontal"
                    android:text="@string/hint_hotspot"
                    android:textColor="@color/jafnify_muted"
                    android:textSize="@dimen/jafnify_type_body"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Status card: who, what is happening now, how long, how much. -->
            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:elevation="@dimen/jafnify_elevation_low"
                android:orientation="vertical"
                android:padding="@dimen/jafnify_spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:drawablePadding="@dimen/jafnify_spacing_sm"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:textSize="@dimen/jafnify_type_body_large" />

                    <ImageButton
                        android:id="@+id/bMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/more_options"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:padding="@dimen/jafnify_spacing_md"
                        android:src="@drawable/ic_more" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tHealth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jafnify_spacing_xs"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="start"
                    android:minHeight="@dimen/jafnify_line_height_body"
                    android:textColor="@color/jafnify_muted"
                    android:textSize="@dimen/jafnify_type_body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jafnify_spacing_xs"
                    android:gravity="start"
                    android:minHeight="@dimen/jafnify_line_height_body"
                    android:textSize="@dimen/jafnify_type_body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tElapsed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jafnify_spacing_xs"
                    android:gravity="start"
                    android:minHeight="@dimen/jafnify_line_height_body"
                    android:textSize="@dimen/jafnify_type_body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tTraffic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jafnify_spacing_xs"
                    android:gravity="start"
                    android:minHeight="@dimen/jafnify_line_height_body"
                    android:textSize="@dimen/jafnify_type_body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tLast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jafnify_spacing_xs"
                    android:gravity="start"
                    android:minHeight="@dimen/jafnify_line_height_body"
                    android:textSize="@dimen/jafnify_type_body"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- The tile home: the card, the tiles and the row of buttons.
                 It is the standard screen; the old card above is only the
                 internal fallback when a tile home fails to render. -->
            <LinearLayout
                android:id="@+id/tileHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/tileCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:elevation="@dimen/jafnify_elevation_low"
                    android:orientation="vertical"
                    android:padding="@dimen/jafnify_spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/tileDot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:layout_marginEnd="@dimen/jafnify_spacing_sm" />

                        <TextView
                            android:id="@+id/tTileTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/jafnify_type_body_large"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/bTileMore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/more_options"
                            android:minHeight="48dp"
                            android:minWidth="48dp"
                            android:padding="@dimen/jafnify_spacing_md"
                            android:src="@drawable/ic_more" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tTileSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jafnify_spacing_xs"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textColor="@color/jafnify_muted"
                        android:textSize="@dimen/jafnify_type_body" />

                    <TextView
                        android:id="@+id/tTileNotice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jafnify_spacing_xs"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/jafnify_muted"
                        android:textSize="@dimen/jafnify_type_caption" />

                    <!-- Doze can pause sharing on battery. One sentence while
                         sharing without the exemption; the sentence itself
                         opens the system list, and Dismiss hides it for the
                         rest of this sharing run. -->
                    <LinearLayout
                        android:id="@+id/batteryBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jafnify_spacing_xs"
                        android:background="@drawable/banner_bg"
                        android:orientation="vertical"
                        android:padding="@dimen/jafnify_spacing_md"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tBatteryNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:minHeight="48dp"
                            android:minWidth="48dp"
                            android:text="@string/battery_hint_note"
                            android:textColor="@color/jafnify_wait_text"
                            android:textSize="@dimen/jafnify_type_body" />

                        <TextView
                            android:id="@+id/bBatteryDismiss"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/jafnify_spacing_xs"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:minHeight="48dp"
                            android:minWidth="48dp"
                            android:text="@string/battery_hint_dismiss"
                            android:textColor="@color/jafnify_fg"
                            android:textSize="@dimen/jafnify_type_body" />
                    </LinearLayout>

                    <!-- The pairing code lives in the card itself: the tile
                         home is the only home, so the code must be on it. -->
                    <LinearLayout
                        android:id="@+id/pairTileBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jafnify_spacing_sm"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pair_code_label"
                            android:textColor="@color/jafnify_muted"
                            android:textSize="@dimen/jafnify_type_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tTileCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/jafnify_spacing_xs"
                            android:fontFamily="monospace"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/jafnify_fg"
                            android:textSize="@dimen/jafnify_type_display"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tTileCodeExpiry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/jafnify_spacing_xs"
                            android:drawablePadding="@dimen/jafnify_spacing_sm"
                            android:gravity="start"
                            android:textColor="@color/jafnify_muted"
                            android:textSize="@dimen/jafnify_type_body"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tileCardButtons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jafnify_spacing_sm"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/bTileHotspot"
                            style="@style/JafnifyTextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/jafnify_spacing_sm"
                            android:minHeight="48dp"
                            android:minWidth="48dp"
                            android:text="@string/btn_hotspot_settings"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/bTileStop"
                            style="@style/JafnifyPrimaryButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:minWidth="48dp" />

                        <Button
                            android:id="@+id/bTileNewCode"
                            style="@style/JafnifyTextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/jafnify_spacing_md"
                            android:minHeight="48dp"
                            android:minWidth="48dp"
                            android:text="@string/btn_new_code"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- The tiles: three rows of two at most, filled in code. -->
                <LinearLayout
                    android:id="@+id/tileGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jafnify_spacing_lg"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/tileButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jafnify_spacing_lg"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/bTileBestSpot"
                        style="@style/JafnifyTextButton"
                        android:background="@drawable/card_bg"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/jafnify_spacing_sm"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:text="@string/menu_best_spot" />

                    <Button
                        android:id="@+id/bTilePhone"
                        style="@style/JafnifyTextButton"
                        android:background="@drawable/card_bg"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/jafnify_spacing_sm"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/jafnify_spacing_sm"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:text="@string/menu_this_phone" />

                    <Button
                        android:id="@+id/bTileStats"
                        style="@style/JafnifyTextButton"
                        android:background="@drawable/card_bg"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/jafnify_spacing_sm"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/jafnify_spacing_sm"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:text="@string/menu_statistics" />
                </LinearLayout>
            </LinearLayout>

            <!-- Shown only while a code pairing runs: the code is the surface. -->
            <LinearLayout
                android:id="@+id/pairBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jafnify_spacing_lg"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/pairCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:elevation="@dimen/jafnify_elevation_low"
                    android:orientation="vertical"
                    android:padding="@dimen/jafnify_spacing_lg">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pair_code_label"
                        android:textColor="@color/jafnify_muted"
                        android:textSize="@dimen/jafnify_type_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jafnify_spacing_sm"
                        android:fontFamily="monospace"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/code_placeholder"
                        android:textColor="@color/jafnify_fg"
                        android:textSize="@dimen/jafnify_type_display"
                        android:textStyle="bold" />

                <TextView
                    android:id="@+id/tCodeExpiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jafnify_spacing_xs"
                    android:drawablePadding="@dimen/jafnify_spacing_sm"
                    android:gravity="start"
                    android:textColor="@color/jafnify_muted"
                    android:textSize="@dimen/jafnify_type_body"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jafnify_spacing_xs"
                    android:gravity="start"
                    android:text="@string/code_hint"
                    android:textSize="@dimen/jafnify_type_body" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jafnify_spacing_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/bCancel"
                        style="@style/JafnifyPrimaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:text="@string/btn_cancel" />

                    <Button
                        android:id="@+id/bNewCode"
                        style="@style/JafnifyTextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/jafnify_spacing_md"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:text="@string/btn_new_code" />
                </LinearLayout>
            </LinearLayout>

            <!-- The one filled button on the screen. -->
            <Button
                android:id="@+id/bToggle"
                style="@style/JafnifyPrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/jafnify_spacing_lg"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="@string/btn_share" />

            <Button
                android:id="@+id/bDetails"
                style="@style/JafnifyTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jafnify_spacing_sm"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="@string/details_show" />

            <!-- Technical details, collapsed by default. The moving handshake
                 age lives here, not on the status card. -->
            <LinearLayout
                android:id="@+id/detailsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jafnify_spacing_sm"
                android:background="@drawable/card_bg"
                android:elevation="@dimen/jafnify_elevation_low"
                android:orientation="vertical"
                android:padding="@dimen/jafnify_spacing_lg"
                android:visibility="gone">

                <!-- Label/value rows, filled by MainActivity.renderDetails. -->
                <LinearLayout
                    android:id="@+id/detailsRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
