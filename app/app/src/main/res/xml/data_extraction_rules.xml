<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ extraction rules. state.toml holds the pairing private key
     (SECURITY.md, "How Jafnify handles secrets"), so neither cloud backup nor device-to-device
     transfer may take any app data. allowBackup is false as well. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
