<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 backup rules. state.toml holds the pairing private key
     (SECURITY.md, "How Jafnify handles secrets"), so nothing is backed up. allowBackup is false
     as well; this file is the belt-and-braces for devices that still run the
     legacy backup path. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
