<?xml version="1.0" encoding="utf-8"?>
<!-- The card's visible ground: surface, a line border and the md radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/jafnify_radius_md" />
    <solid android:color="@color/jafnify_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/jafnify_line" />
</shape>
